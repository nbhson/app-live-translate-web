DEEPGRAM_API_KEY=dg_YOUR_KEY_HERE
# STT provider: deepgram (WER 9%, 300ms) | whisper (free forever, WER 10%, 1.2-2s, self-host)
STT_PROVIDER=whisper
TRANSLATE_PROVIDER=auto
# Whisper self-host (khi STT_PROVIDER=whisper hoặc deepgram hết key -> auto fallback whisper)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_CHUNK_MS=1800
# TRANSLATE_PROVIDER=free  # MyMemory free 5000 ký tự/ngày
# TRANSLATE_PROVIDER=ai    # AI custom bên dưới
PORT=8000

# --- AI duy nhất: Custom OpenAI-compatible (Ollama, vLLM, OpenRouter, Groq, Together, Azure...) ---
# Dùng cho cả translate (ai) + summary phase 3, chỉ cần 3 biến này
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=gpt-4o-mini
# Ví dụ Ollama local: CUSTOM_BASE_URL=http://localhost:11434/v1 , CUSTOM_API_KEY=ollama
# Ví dụ OpenRouter: CUSTOM_BASE_URL=https://openrouter.ai/api/v1

TRANSLATE_STREAM=0

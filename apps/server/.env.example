DEEPGRAM_API_KEY=dg_YOUR_KEY_HERE
GOOGLE_TRANSLATE_KEY=
# AI - Translate (Phase 2: khi TRANSLATE_PROVIDER=llm thì dùng LLM thay vì Google)
STT_PROVIDER=deepgram
TRANSLATE_PROVIDER=google
# TRANSLATE_PROVIDER=llm  # bật để dịch bằng LLM
PORT=8000

# --- AI LLM config (dùng cho cả translate llm + summary phase 3) ---
# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
# OpenAI / OpenAI-compatible (OpenRouter, Azure...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Custom provider - bất kỳ endpoint OpenAI-compatible nào (Ollama, vLLM, Together, Groq, OpenRouter...)
# Khi dùng local Ollama: CUSTOM_BASE_URL=http://localhost:11434/v1 , CUSTOM_API_KEY=ollama
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=llama3.1
# (tuỳ chọn) model riêng cho summary nếu muốn khác translate
# SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_PROVIDER=auto  # auto | gemini | openai | custom
TRANSLATE_STREAM=0
GEMINI_TRANSLATE_MODEL=gemini-2.0-flash
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
